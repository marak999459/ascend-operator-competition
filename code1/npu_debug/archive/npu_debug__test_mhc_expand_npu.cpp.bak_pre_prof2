// 走 aclnn 两段式：aclCreateTensor -> aclnnMhcExpandGetWorkspaceSize -> aclnnMhcExpand
// 用例矩阵与参考实现与 cpu_debug/test_mhc_expand_cpu.cpp 逐条同源，日志可直接对拍。
#include <acl/acl.h>
